{
  "name": "at-nacos",
  "displayName": "%atNacos.displayName%",
  "description": "%atNacos.description%",
  "version": "0.1.2",
  "publisher": "local",
  "icon": "media/at-nacos-icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nacos",
    "config",
    "service-discovery",
    "microservices",
    "mcp",
    "at-series"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atNacos",
          "title": "%atNacos.viewsContainer.title%",
          "icon": "media/at-nacos-activity.svg"
        }
      ]
    },
    "views": {
      "atNacos": [
        {
          "id": "atNacos.configs",
          "name": "%atNacos.view.configs.name%"
        },
        {
          "id": "atNacos.services",
          "name": "%atNacos.view.services.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "atNacos.addInstance",
        "title": "%atNacos.command.addInstance.title%",
        "icon": "$(add)"
      },
      {
        "command": "atNacos.manageInstances",
        "title": "%atNacos.command.manageInstances.title%",
        "icon": "$(gear)"
      },
      {
        "command": "atNacos.refreshConfigs",
        "title": "%atNacos.command.refreshConfigs.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "atNacos.refreshServices",
        "title": "%atNacos.command.refreshServices.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "atNacos.filterConfigs",
        "title": "%atNacos.command.filterConfigs.title%",
        "icon": "$(filter)"
      },
      {
        "command": "atNacos.clearConfigFilter",
        "title": "%atNacos.command.clearConfigFilter.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "atNacos.openConfig",
        "title": "%atNacos.command.openConfig.title%"
      },
      {
        "command": "atNacos.loadMoreConfigs",
        "title": "%atNacos.command.loadMoreConfigs.title%"
      },
      {
        "command": "atNacos.loadMoreServices",
        "title": "%atNacos.command.loadMoreServices.title%"
      },
      {
        "command": "atNacos.openClusterStatus",
        "title": "%atNacos.command.openClusterStatus.title%",
        "icon": "$(server)"
      },
      {
        "command": "atNacos.showConfigHistory",
        "title": "%atNacos.command.showConfigHistory.title%"
      },
      {
        "command": "atNacos.diffWithPrevious",
        "title": "%atNacos.command.diffWithPrevious.title%"
      },
      {
        "command": "atNacos.compareAcrossEnvironments",
        "title": "%atNacos.command.compareAcrossEnvironments.title%"
      },
      {
        "command": "atNacos.showConfigListeners",
        "title": "%atNacos.command.showConfigListeners.title%"
      },
      {
        "command": "atNacos.showServiceSubscribers",
        "title": "%atNacos.command.showServiceSubscribers.title%"
      },
      {
        "command": "atNacos.editConfig",
        "title": "%atNacos.command.editConfig.title%",
        "icon": "$(edit)"
      },
      {
        "command": "atNacos.publishConfig",
        "title": "%atNacos.command.publishConfig.title%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "atNacos.deleteConfig",
        "title": "%atNacos.command.deleteConfig.title%",
        "icon": "$(trash)"
      },
      {
        "command": "atNacos.enableServiceInstance",
        "title": "%atNacos.command.enableServiceInstance.title%"
      },
      {
        "command": "atNacos.disableServiceInstance",
        "title": "%atNacos.command.disableServiceInstance.title%"
      },
      {
        "command": "atNacos.installMcpConfig",
        "title": "%atNacos.command.installMcpConfig.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "atNacos.openConfig",
          "when": "false"
        },
        {
          "command": "atNacos.loadMoreConfigs",
          "when": "false"
        },
        {
          "command": "atNacos.loadMoreServices",
          "when": "false"
        },
        {
          "command": "atNacos.showConfigHistory",
          "when": "false"
        },
        {
          "command": "atNacos.diffWithPrevious",
          "when": "false"
        },
        {
          "command": "atNacos.compareAcrossEnvironments",
          "when": "false"
        },
        {
          "command": "atNacos.showConfigListeners",
          "when": "false"
        },
        {
          "command": "atNacos.showServiceSubscribers",
          "when": "false"
        },
        {
          "command": "atNacos.editConfig",
          "when": "false"
        },
        {
          "command": "atNacos.publishConfig",
          "when": "false"
        },
        {
          "command": "atNacos.deleteConfig",
          "when": "false"
        },
        {
          "command": "atNacos.enableServiceInstance",
          "when": "false"
        },
        {
          "command": "atNacos.disableServiceInstance",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "atNacos.publishConfig",
          "when": "resourceScheme == nacos-draft",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "atNacos.editConfig",
          "when": "viewItem == atNacos.config",
          "group": "atNacos.modify@1"
        },
        {
          "command": "atNacos.publishConfig",
          "when": "viewItem == atNacos.config",
          "group": "atNacos.modify@2"
        },
        {
          "command": "atNacos.deleteConfig",
          "when": "viewItem == atNacos.config",
          "group": "atNacos.modify@3"
        },
        {
          "command": "atNacos.showConfigHistory",
          "when": "viewItem =~ /^atNacos\\.config\\b/",
          "group": "atNacos.inspect@1"
        },
        {
          "command": "atNacos.diffWithPrevious",
          "when": "viewItem =~ /^atNacos\\.config\\b/",
          "group": "atNacos.inspect@2"
        },
        {
          "command": "atNacos.compareAcrossEnvironments",
          "when": "viewItem =~ /^atNacos\\.config\\b/",
          "group": "atNacos.inspect@3"
        },
        {
          "command": "atNacos.showConfigListeners",
          "when": "viewItem =~ /^atNacos\\.config\\b/",
          "group": "atNacos.inspect@4"
        },
        {
          "command": "atNacos.showServiceSubscribers",
          "when": "viewItem =~ /^atNacos\\.service\\b/",
          "group": "atNacos.inspect@1"
        },
        {
          "command": "atNacos.enableServiceInstance",
          "when": "viewItem == atNacos.serviceInstance.disabled",
          "group": "atNacos.modify@1"
        },
        {
          "command": "atNacos.disableServiceInstance",
          "when": "viewItem == atNacos.serviceInstance.enabled",
          "group": "atNacos.modify@2"
        }
      ],
      "view/title": [
        {
          "command": "atNacos.addInstance",
          "when": "view == atNacos.configs",
          "group": "navigation@1"
        },
        {
          "command": "atNacos.refreshConfigs",
          "when": "view == atNacos.configs",
          "group": "navigation@2"
        },
        {
          "command": "atNacos.filterConfigs",
          "when": "view == atNacos.configs",
          "group": "navigation@3"
        },
        {
          "command": "atNacos.clearConfigFilter",
          "when": "view == atNacos.configs",
          "group": "navigation@4"
        },
        {
          "command": "atNacos.openClusterStatus",
          "when": "view == atNacos.configs",
          "group": "navigation@5"
        },
        {
          "command": "atNacos.manageInstances",
          "when": "view == atNacos.configs",
          "group": "navigation@6"
        },
        {
          "command": "atNacos.addInstance",
          "when": "view == atNacos.services",
          "group": "navigation@1"
        },
        {
          "command": "atNacos.refreshServices",
          "when": "view == atNacos.services",
          "group": "navigation@2"
        },
        {
          "command": "atNacos.openClusterStatus",
          "when": "view == atNacos.services",
          "group": "navigation@3"
        },
        {
          "command": "atNacos.manageInstances",
          "when": "view == atNacos.services",
          "group": "navigation@4"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "atNacos.configs",
        "contents": "%atNacos.welcome.configs%"
      },
      {
        "view": "atNacos.services",
        "contents": "%atNacos.welcome.services%"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/copy-hub.mjs && node esbuild.config.mjs",
    "watch": "node scripts/copy-hub.mjs && node esbuild.config.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@at-series/mcp-hub": "^0.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
